venv/
env/
.venv/

# PyInstaller build artifacts
build/
dist/
*.spec

# 配布用の実行ファイル（GitHubには置かず直接配布する）
*.exe

# Packaging
*.egg-info/

# Logs
*.log

# Editor settings
.vscode/

# Windows
Thumbs.db

# Sudachi dictionary (巨大ファイル)
*.dic
# 動作確認用フィクスチャ（tests/make_fixture_*.py で再生成できる）
tests/fixtures/

# 実ファイルでの動作確認用（実際の授業プリントなので公開しない）
test/

# 第三者ライセンス告知（packaging/gen_notices.py が毎回生成する）
packaging/THIRD-PARTY-NOTICES.txt
